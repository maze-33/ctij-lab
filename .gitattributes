* text=auto

# Unity YAML assets: merge as text, keep LF
*.unity    text eol=lf
*.prefab   text eol=lf
*.asset    text eol=lf
*.meta     text eol=lf
*.mat      text eol=lf
*.anim     text eol=lf
*.controller text eol=lf
*.cs       text diff=csharp

# Binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.psd  binary
*.fbx  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.ttf  binary
*.otf  binary
